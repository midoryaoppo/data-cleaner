# Copy this file to .env for local development and adjust as needed.
# For production, use .env.production.example and follow DEPLOYMENT.md.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Public base URL used for Stripe success/cancel redirects.
# In production this must be the final HTTPS URL users visit, with no trailing
# slash. When empty, production falls back to RENDER_EXTERNAL_URL or
# RAILWAY_PUBLIC_DOMAIN.
APP_URL=http://127.0.0.1:3000

# Extra comma-separated browser origins allowed to call /api. The APP_URL
# origin is always allowed automatically. Use full origins such as
# https://example.com,https://www.example.com (no wildcards).
CORS_ORIGIN=

# Set to true when running behind a reverse proxy / load balancer.
# Render and Railway terminate TLS at one proxy: use true there.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# PostgreSQL persistence
# ---------------------------------------------------------------------------

# Connection string for PostgreSQL. When set, entitlements and uploaded files
# are persisted and survive restarts/redeploys. Leave blank for local
# development to use the in-memory stores (data is lost on restart).
# Example: postgresql://postgres:postgres@127.0.0.1:5432/tidydata
DATABASE_URL=

# Enable TLS for hosted databases that require SSL. Render internal connection
# strings usually do not need this; external/public URLs typically do.
DATABASE_SSL=false

# Maximum PostgreSQL pool connections held by this process.
DATABASE_POOL_MAX=10

# Apply pending SQL migrations on startup. Keep true in production. Manual
# runs are available with `npm run db:migrate`.
AUTO_MIGRATE=true

# Upload constraints
MAX_FILE_SIZE_MB=10
MAX_ROWS=200000
MAX_COLUMNS=200

# How long uploaded/cleaned files stay available before being purged
FILE_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Freemium limits
# ---------------------------------------------------------------------------

# Free users can preview any supported file up to MAX_FILE_SIZE_MB, but they
# can only clean/download files within these limits. Any active export pass or
# subscription lifts both limits and unlocks bulk processing.
FREE_TIER_MAX_ROWS=500
FREE_TIER_MAX_FILE_MB=1

# Comma-separated export formats that require premium access. CSV and JSON are
# free; NDJSON and TSV are premium by default. Use "none" to make every format
# free, or add "json" if you want to gate JSON too.
PREMIUM_EXPORT_FORMATS=ndjson,tsv

# Maximum number of files accepted by POST /api/clean/bulk.
BULK_MAX_FILES=10

# ---------------------------------------------------------------------------
# Stripe billing
# ---------------------------------------------------------------------------

# Stripe secret key. Leave empty to run sandbox-only checkout.
# Test keys start with sk_test_ and live keys start with sk_live_.
STRIPE_SECRET_KEY=

# Webhook signing secret from `stripe listen` or the Stripe dashboard.
# Point Stripe at https://yourdomain.com/api/webhook (the legacy
# /api/billing/webhook alias also works).
STRIPE_WEBHOOK_SECRET=

# Optional pre-created Stripe Price IDs. When empty, Checkout uses dynamic
# price_data with the amounts below.
STRIPE_PRICE_SINGLE_ID=
STRIPE_PRICE_MONTHLY_ID=

STRIPE_CURRENCY=usd
SINGLE_EXPORT_PRICE_CENTS=500
MONTHLY_PRICE_CENTS=1900

# Sandbox checkout simulates a purchase without contacting Stripe. It is
# enabled by default outside production and refused when NODE_ENV=production
# unless explicitly enabled here. Never enable it on a public production site.
ENABLE_BILLING_SANDBOX=true

# Long random value used to sign entitlement cookies. Set this in production so
# cookies remain verifiable across restarts (the default is random per process).
BILLING_SECRET=replace-with-a-long-random-string

# Exports above this many cleaned rows require an export pass or subscription.
# This is a second, export-side guard on top of FREE_TIER_MAX_ROWS.
HIGH_VOLUME_ROW_LIMIT=5000

# Access windows for the one-time pass and monthly subscription.
SINGLE_EXPORT_PASS_HOURS=24
SUBSCRIPTION_ACCESS_DAYS=31

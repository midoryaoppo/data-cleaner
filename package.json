{
  "name": "tidydata",
  "version": "1.0.0",
  "private": true,
  "description": "TidyData — a clean, full-stack CSV/JSON data cleaner and converter.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -n server,css -c cyan,magenta \"node --watch server.js\" \"npm:watch:css\"",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/css/styles.css --watch",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "keywords": [
    "csv",
    "json",
    "data-cleaning",
    "express",
    "tailwindcss"
  ],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "csv-parser": "^3.2.1",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "json2csv": "^6.0.0-alpha.2",
    "multer": "^2.5.0",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "tailwindcss": "^3.4.17"
  }
}

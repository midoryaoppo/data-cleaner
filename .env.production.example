# Production environment template for TidyData.
# Copy the values into your Render/Railway environment settings. Never commit
# a populated .env.production file or real secrets to version control.

NODE_ENV=production
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Required public URL and cookie signing secret
# ---------------------------------------------------------------------------

# Public HTTPS origin users visit. No trailing slash. This controls Stripe
# success/cancel redirects and is automatically allowed by CORS.
APP_URL=https://yourdomain.com

# Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BILLING_SECRET=replace-with-a-64-character-random-hex-string

# ---------------------------------------------------------------------------
# Required PostgreSQL database
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Entitlements, webhook deduplication, and
# uploaded/cleaned files are persisted here so restarts and redeploys do not
# clear purchases or active sessions. On Render, use the Internal Database URL
# from the PostgreSQL service (or let render.yaml provision it for you).
# Railway: add the PostgreSQL plugin and reference DATABASE_URL from it.
DATABASE_URL=postgresql://user:password@host:5432/tidydata

# Enable TLS when connecting over a public/external database URL. Internal
# Render/Railway connections normally stay on the private network.
DATABASE_SSL=false

# Maximum PostgreSQL pool connections held by each app instance.
DATABASE_POOL_MAX=10

# Apply pending migrations automatically when the service starts. The server
# acquires a PostgreSQL advisory lock so concurrent deploys are safe.
AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# Required Stripe live credentials
# ---------------------------------------------------------------------------

# Live secret key from Stripe Dashboard -> Developers -> API keys.
# Test mode uses sk_test_...; live mode uses sk_live_...
STRIPE_SECRET_KEY=sk_live_replace_me

# Signing secret for the webhook endpoint:
# https://yourdomain.com/api/webhook
# (the legacy https://yourdomain.com/api/billing/webhook alias also works)
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---------------------------------------------------------------------------
# Optional Stripe pricing configuration
# ---------------------------------------------------------------------------

# Leave these empty to let Checkout create prices dynamically from the amounts
# below, or create Stripe Prices and paste their IDs here.
STRIPE_PRICE_SINGLE_ID=
STRIPE_PRICE_MONTHLY_ID=
STRIPE_CURRENCY=usd
SINGLE_EXPORT_PRICE_CENTS=500
MONTHLY_PRICE_CENTS=1900

# Must be false on a public production deployment.
ENABLE_BILLING_SANDBOX=false

# ---------------------------------------------------------------------------
# Production HTTP / proxy settings
# ---------------------------------------------------------------------------

# Render and Railway terminate TLS at one reverse proxy.
TRUST_PROXY=true

# Optional additional browser origins, comma-separated. APP_URL is always
# allowed automatically. Add both apex and www if you serve both.
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# Optional limits and access windows
# ---------------------------------------------------------------------------

MAX_FILE_SIZE_MB=10
MAX_ROWS=200000
MAX_COLUMNS=200
FILE_TTL_MINUTES=30
FREE_TIER_MAX_ROWS=500
FREE_TIER_MAX_FILE_MB=1
PREMIUM_EXPORT_FORMATS=ndjson,tsv
BULK_MAX_FILES=10
HIGH_VOLUME_ROW_LIMIT=5000
SINGLE_EXPORT_PASS_HOURS=24
SUBSCRIPTION_ACCESS_DAYS=31
